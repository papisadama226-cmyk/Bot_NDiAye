# Numéro du/des propriétaire(s) du bot, format international sans le +, séparés par des virgules
# Exemple: 22501020304,22505060708
OWNER_NUMBERS=22501020304

# Numéro WhatsApp du bot lui-même (pour le pairing code), format international sans le +
BOT_PHONE_NUMBER=22599999999

# Clé API Gemini (depuis aistudio.google.com/apikey), utilisée pour !ia, !trad, !resume
AI_API_KEY=AIzaSy_ta_cle_ici
AI_MODEL=gemini-2.0-flash

# Préfixe des commandes
PREFIX=!

# Répondeur automatique (messages privés uniquement, désactivé par défaut)
AUTO_REPLY_ENABLED=false
AUTO_REPLY_MESSAGE=Je suis occupé pour le moment, je vous répondrai dès que possible 🙏
AUTO_REPLY_COOLDOWN_MIN=60
